# Copy to .env and replace every placeholder before starting the application.
DATABASE_URL=postgresql+asyncpg://app:change-me@pgbouncer:6432/app_db
DIRECT_DATABASE_URL=postgresql+asyncpg://app:change-me@postgres:5432/app_db
REDIS_CLUSTER_NODES=["redis-1:6379","redis-2:6379","redis-3:6379"]
REDIS_PASSWORD=
SEARCH_INDEX_PATH=.data/tantivy
AES_256_MASTER_KEY_B64=replace-with-base64-encoded-32-random-bytes
BLIND_INDEX_KEY_B64=replace-with-a-different-base64-encoded-32-random-bytes
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DEFAULT_ADMIN_EMAIL=admin@example.test
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
DEFAULT_ADMIN_PHONE=+10000000000
DEFAULT_ADMIN_NID=bootstrap-only-change-me
LOG_LEVEL=INFO
